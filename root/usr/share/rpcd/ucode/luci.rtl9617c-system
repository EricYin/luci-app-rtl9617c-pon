'use strict';
import { readfile, glob } from 'fs';
import { read_int, read_entropy } from 'rtl9617c.hw';

function read_time_in_state(policy) {
	let raw = readfile(policy + 'stats/time_in_state');
	if (raw == null)
		return [];
	let out = [];
	for (let line in split(trim(raw), '\n')) {
		let m = match(trim(line), /^([0-9]+)\s+([0-9]+)$/);
		if (m != null)
			push(out, { khz: +m[1], ticks: +m[2] });
	}
	return out;
}

function read_vsfc() {
	let dirs = glob('/sys/bus/platform/devices/*.vsfc');
	if (!length(dirs))
		return { available: false };
	let base = dirs[0] + '/';
	let en = read_int(base + 'enabled');
	let status_raw = readfile(base + 'status');
	if (en == null && status_raw == null)
		return { available: false };
	return {
		available: true,
		enabled: en == 1,
		trig_cnt: read_int(base + 'trig_cnt'),
		status: status_raw == null ? null : trim(status_raw)
	};
}

return {
	'luci.rtl9617c-system': {
		status: {
			call: function() {
				let temperature = null;
				for (let path in glob('/sys/class/thermal/thermal_zone*')) {
					if (trim(readfile(path + '/type')) == 'cpu-thermal') {
						temperature = read_int(path + '/temp');
						break;
					}
				}
				let policy = '/sys/devices/system/cpu/cpufreq/policy0/';
				let available = readfile(policy + 'scaling_available_frequencies');
				let avail_gov = readfile(policy + 'scaling_available_governors');
				let governor = readfile(policy + 'scaling_governor');
				return {
					temperature_mC: temperature,
					cpu: {
						available_khz: available == null || !match(trim(available), /^[0-9]+(\s+[0-9]+)*$/) ? [] :
							map(split(trim(available), /\s+/), (value) => +value),
						available_governors: avail_gov == null || trim(avail_gov) == '' ? [] :
							split(trim(avail_gov), /\s+/),
						current_khz: read_int(policy + 'cpuinfo_cur_freq') ?? read_int(policy + 'scaling_cur_freq'),
						min_khz: read_int(policy + 'scaling_min_freq'),
						max_khz: read_int(policy + 'scaling_max_freq'),
						setspeed_khz: read_int(policy + 'scaling_setspeed'),
						transition_error: read_int('/sys/bus/platform/devices/f4320200.clock-controller/transition_error'),
						governor: governor == null ? null : trim(governor),
						time_in_state: read_time_in_state(policy)
					},
					vsfc: read_vsfc(),
					entropy: read_entropy()
				};
			}
		}
	}
};
