#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=20
USE_PROCD=1

POLICY=/sys/devices/system/cpu/cpufreq/policy0

freq_in_list() {
	local val="$1" list="$2"
	case " $list " in
		*" $val "*) return 0 ;;
		*) return 1 ;;
	esac
}

apply() {
	local governor frequency min_freq max_freq available avail_gov
	local hw_min hw_max current

	[ -d "$POLICY" ] || return 0

	config_load system
	config_get governor cpu governor
	config_get frequency cpu frequency
	config_get min_freq cpu min_freq
	config_get max_freq cpu max_freq

	read -r available < "$POLICY/scaling_available_frequencies" || return 1
	read -r avail_gov < "$POLICY/scaling_available_governors" || return 1
	read -r hw_min < "$POLICY/cpuinfo_min_freq" || hw_min=""
	read -r hw_max < "$POLICY/cpuinfo_max_freq" || hw_max=""

	if [ -z "$governor" ]; then
		if [ -n "$frequency" ]; then
			governor="userspace"
		elif freq_in_list "schedutil" "$avail_gov"; then
			governor="schedutil"
		else
			governor="userspace"
		fi
	fi

	if ! freq_in_list "$governor" "$avail_gov"; then
		logger -t rtl9617c-cpu "unsupported governor: $governor (available: $avail_gov)"
		return 1
	fi

	# Widen bounds first so subsequent min/max/setspeed writes never hit EINVAL.
	[ -n "$hw_min" ] && printf '%s\n' "$hw_min" > "$POLICY/scaling_min_freq" 2>/dev/null
	[ -n "$hw_max" ] && printf '%s\n' "$hw_max" > "$POLICY/scaling_max_freq" 2>/dev/null

	if [ "$governor" = "userspace" ]; then
		[ -n "$frequency" ] || return 0
		if ! freq_in_list "$frequency" "$available"; then
			logger -t rtl9617c-cpu "unsupported frequency: $frequency kHz"
			return 1
		fi
		printf 'userspace\n' > "$POLICY/scaling_governor" || return 1
		printf '%s\n' "$frequency" > "$POLICY/scaling_setspeed" || return 1

		read -r current < "$POLICY/cpuinfo_cur_freq" || return 1
		[ "$current" = "$frequency" ] || {
			logger -t rtl9617c-cpu "requested $frequency kHz, running $current kHz"
			return 1
		}
		return 0
	fi

	printf '%s\n' "$governor" > "$POLICY/scaling_governor" || return 1

	[ -n "$min_freq" ] || min_freq="$hw_min"
	[ -n "$max_freq" ] || max_freq="$hw_max"
	if [ -n "$min_freq" ] && [ -n "$max_freq" ] && [ "$min_freq" -gt "$max_freq" ]; then
		min_freq="$max_freq"
	fi
	if [ -n "$max_freq" ] && freq_in_list "$max_freq" "$available"; then
		printf '%s\n' "$max_freq" > "$POLICY/scaling_max_freq" || return 1
	fi
	if [ -n "$min_freq" ] && freq_in_list "$min_freq" "$available"; then
		printf '%s\n' "$min_freq" > "$POLICY/scaling_min_freq" || return 1
	fi
}

start_service() {
	apply
}

reload_service() {
	apply
}

service_triggers() {
	procd_add_reload_trigger system
}
